# /etc/robot-monitor/agent.env
# 权限：chown root:robot-monitor && chmod 640

# 用 https:// 或 wss:// 都行，agent 会自己推出 WS 地址和 HTTP base
ROBOT_MONITOR_AGENT_SERVER=https://files.example.com
ROBOT_MONITOR_AGENT_ROOT=/srv/share

# token 不用填：首次启动会自动向 A 注册，凭据写到
# agent/.robot-monitor/agents/<地址>-<hash>.json（0600，源码运行）；wheel 安装时在
# ~/.local/state/robot-monitor/agents/。一台 A 一个文件，换 A 不会覆盖上一台。
# 想固定凭据的话可以手工签发后填在这里：
# ROBOT_MONITOR_AGENT_TOKEN=fba_REPLACE_WITH_ISSUED_TOKEN

# 同时上传的分片数。3 是经验值：再高会让 A 的磁盘寻道成为瓶颈
ROBOT_MONITOR_AGENT_MAX_CONCURRENT_UPLOADS=3
ROBOT_MONITOR_AGENT_HEARTBEAT_INTERVAL=15

# 自签证书的内网测试才设 false
ROBOT_MONITOR_AGENT_VERIFY_TLS=true

ROBOT_MONITOR_AGENT_LOG_DIR=/var/log/robot-monitor
ROBOT_MONITOR_AGENT_LOG_LEVEL=INFO
