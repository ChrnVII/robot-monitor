# /etc/filebridge/agent.env
# 权限：chown root:filebridge && chmod 640

# 用 https:// 或 wss:// 都行，agent 会自己推出 WS 地址和 HTTP base
FILEBRIDGE_AGENT_SERVER=https://files.example.com
FILEBRIDGE_AGENT_ROOT=/srv/share

# token 不用填：首次启动会自动向 A 注册，凭据写到
# ~/.local/state/filebridge/agent.json（0600）。
# 想固定凭据的话可以手工签发后填在这里：
# FILEBRIDGE_AGENT_TOKEN=fba_REPLACE_WITH_ISSUED_TOKEN

# 同时上传的分片数。3 是经验值：再高会让 A 的磁盘寻道成为瓶颈
FILEBRIDGE_AGENT_MAX_CONCURRENT_UPLOADS=3
FILEBRIDGE_AGENT_HEARTBEAT_INTERVAL=15

# 自签证书的内网测试才设 false
FILEBRIDGE_AGENT_VERIFY_TLS=true

FILEBRIDGE_AGENT_LOG_DIR=/var/log/filebridge
FILEBRIDGE_AGENT_LOG_LEVEL=INFO
