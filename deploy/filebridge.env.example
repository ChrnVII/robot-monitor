# /etc/filebridge/filebridge.env
# 权限：chown root:filebridge && chmod 640
#
# 注意单引号：argon2 哈希里有 `$`，不加引号会被 shell/systemd 当变量展开，
# 变成一串空值，然后表现为"密码永远不对"。

FILEBRIDGE_HOST=127.0.0.1
FILEBRIDGE_PORT=8000

# 密码不需要写在这里：首次 serve 会引导设置，之后用 `filebridge-server passwd` 改。
# 老部署可以保留下面这行，启动时会被自动导入数据库（仅一次）：
# FILEBRIDGE_ADMIN_PASSWORD_HASH='$argon2id$v=19$...'

# 新设备准入：first（第一台免审）/ open（全部免审）/ closed（全部人工）
FILEBRIDGE_ENROLL_POLICY=first

FILEBRIDGE_DATA_DIR=/var/lib/filebridge/data
FILEBRIDGE_STORAGE_DIR=/var/lib/filebridge/storage

# 上了 HTTPS 之后必须开，否则 Cookie 会被浏览器拒绝
FILEBRIDGE_COOKIE_SECURE=true
FILEBRIDGE_SESSION_TTL_HOURS=72

# 前端产物位置（用 wheel 部署时手动指）
FILEBRIDGE_FRONTEND_DIR=/opt/filebridge/frontend/dist

FILEBRIDGE_LOG_LEVEL=INFO

# 单文件上限 20GB；磁盘预检会要求剩余 >= 1.2 倍
FILEBRIDGE_MAX_FILE_BYTES=21474836480
FILEBRIDGE_DISK_RESERVE_RATIO=1.2
