[Unit]
Description=Robot Monitor agent (B)
Documentation=https://github.com/your-org/robot-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot-monitor
Group=robot-monitor
EnvironmentFile=/etc/robot-monitor/agent.env

ExecStart=/opt/robot-monitor-agent/.venv/bin/robot-monitor-agent

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# 只读不变量在这里也体现一次：共享目录只读挂载给进程，
# 即使代码有 bug 也写不进去。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/share
ReadWritePaths=/var/log/robot-monitor
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
