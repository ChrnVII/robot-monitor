[Unit]
Description=Robot Monitor server (A)
Documentation=https://github.com/your-org/robot-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robot-monitor
Group=robot-monitor
WorkingDirectory=/opt/robot-monitor/backend
EnvironmentFile=/etc/robot-monitor/robot-monitor.env

# workers 只能是 1：连接注册表在进程内存里，多 worker 会让"节点在线但指令全超时"。
# 这个参数不要改成 --workers N，要扩就先换 Redis pub/sub。
ExecStart=/opt/robot-monitor/backend/.venv/bin/robot-monitor-server serve --host 127.0.0.1 --port 8000

Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# 沙箱化：只允许写 /var/lib/robot-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/robot-monitor
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
